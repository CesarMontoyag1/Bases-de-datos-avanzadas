// ============================================================
// SI3009 - Bases de Datos Avanzadas - Proyecto 3
// SCRIPT 05: MEDIDAS DAX COMPLETAS
// Tabla de medidas: _Medidas
// ============================================================

// ============================================================
// VENTAS BASE
// ============================================================

Total Ventas = SUM(FactVentas[ValorVenta])

Total Costo = SUM(FactVentas[ValorCosto])

Utilidad Bruta = [Total Ventas] - [Total Costo]

Margen Bruto % = DIVIDE([Utilidad Bruta], [Total Ventas], 0)

Total Unidades = SUM(FactVentas[Cantidad])

Total Descuentos = SUM(FactVentas[ValorDescuento])

Ticket Promedio = DIVIDE([Total Ventas], DISTINCTCOUNT(FactVentas[VentaID]), 0)

// ============================================================
// TIME INTELLIGENCE
// ============================================================

Ventas Anio Anterior =
CALCULATE(
    [Total Ventas],
    SAMEPERIODLASTYEAR(DimFecha[Fecha])
)

Ventas Mes Anterior =
CALCULATE(
    [Total Ventas],
    PREVIOUSMONTH(DimFecha[Fecha])
)

Ventas YTD =
TOTALYTD([Total Ventas], DimFecha[Fecha])

Ventas MTD =
TOTALMTD([Total Ventas], DimFecha[Fecha])

Crecimiento Ventas % =
DIVIDE(
    [Total Ventas] - [Ventas Anio Anterior],
    [Ventas Anio Anterior],
    0
)

Promedio Movil 3M =
AVERAGEX(
    DATESINPERIOD(DimFecha[Fecha], LASTDATE(DimFecha[Fecha]), -3, MONTH),
    [Total Ventas]
)

// ============================================================
// METAS Y CUMPLIMIENTO
// ============================================================

Total Metas = SUM(FactMetasComerciales[ValorMeta])

Cumplimiento Meta % = DIVIDE([Total Ventas], [Total Metas], 0)

Brecha Meta = [Total Ventas] - [Total Metas]

Semaforo Cumplimiento =
SWITCH(
    TRUE(),
    [Cumplimiento Meta %] >= 1,    "Verde",
    [Cumplimiento Meta %] >= 0.8,  "Amarillo",
    "Rojo"
)

// ============================================================
// RANKINGS
// ============================================================

Ranking Productos =
RANKX(
    ALL(DimProducto[NombreProducto]),
    [Total Ventas],
    ,
    DESC,
    DENSE
)

Ranking Tiendas =
RANKX(
    ALL(DimTienda[NombreTienda]),
    [Total Ventas],
    ,
    DESC,
    DENSE
)

Ranking Vendedores =
RANKX(
    ALL(DimVendedor[NombreCompleto]),
    [Total Ventas],
    ,
    DESC,
    DENSE
)

Top 10 Productos =
IF([Ranking Productos] <= 10, [Total Ventas])

// ============================================================
// PARTICIPACION
// ============================================================

Participacion Tienda % =
DIVIDE(
    [Total Ventas],
    CALCULATE([Total Ventas], ALL(DimTienda)),
    0
)

Participacion Categoria % =
DIVIDE(
    [Total Ventas],
    CALCULATE([Total Ventas], ALL(DimProducto[Categoria])),
    0
)

Participacion Canal % =
DIVIDE(
    [Total Ventas],
    CALCULATE([Total Ventas], ALL(DimCanalVenta)),
    0
)

// ============================================================
// INVENTARIO
// ============================================================

Stock Actual = CALCULATE(SUM(FactInventarioDiario[StockFinal]))

Inventario Promedio =
AVERAGEX(
    VALUES(DimProducto[NombreProducto]),
    [Stock Actual]
)

Rotacion Inventario =
DIVIDE([Total Costo], [Inventario Promedio], 0)

Dias Inventario Disponible =
DIVIDE(
    [Inventario Promedio],
    DIVIDE([Total Costo], 365, 0),
    0
)

Productos Bajo Stock =
CALCULATE(
    DISTINCTCOUNT(DimProducto[ProductoID]),
    FILTER(
        VALUES(DimProducto[ProductoID]),
        [Stock Actual] <= 50
    )
)

// ============================================================
// DEVOLUCIONES
// ============================================================

Total Devoluciones = SUM(FactDevoluciones[ValorDevuelto])

Tasa Devolucion % =
DIVIDE([Total Devoluciones], [Total Ventas], 0)

Unidades Devueltas = SUM(FactDevoluciones[CantidadDevuelta])

// ============================================================
// RENTABILIDAD
// ============================================================

Margen Neto % =
DIVIDE([Utilidad Bruta] - [Total Devoluciones], [Total Ventas], 0)

Margen vs Promedio =
[Margen Bruto %] - CALCULATE([Margen Bruto %], ALL(DimProducto))

Utilidad Neta = [Utilidad Bruta] - [Total Devoluciones]
